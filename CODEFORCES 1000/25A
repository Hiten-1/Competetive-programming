#include <bits/stdc++.h>
using namespace std;

int main() {
	int n;
	cin>>n;
	vector<int> nums(n);
	vector<int> e;
	vector<int> o;
	
	for (int i=0;i<n;++i){
	    cin>>nums[i];
	}
	
	for (int i=0;i<n;++i){
	    if (nums[i]%2==0){
	        e.push_back(i);
	    }if (nums[i]%2!=0){
	        o.push_back(i);
	    }
	}int no=o.size();
	int ne=e.size();
	int ans;
	
	if (no==1){
	    ans=o[0];
	}else if(ne==1){
	    
	    ans=e[0];
	    
	}cout<<ans+1<<endl;

}
