#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> nums(n);

    for (int i = 0; i < n; ++i) {
        cin >> nums[i];
    }

    int maxPos = 0;
    int minPos = 0;

    for (int i = 0; i < n; ++i) {
        if (nums[i] > nums[maxPos]) {
            maxPos = i;
        }

        if (nums[i] <= nums[minPos]) {
            minPos = i;
        }
    }

    int ans;

    if (maxPos < minPos) {
        ans = maxPos + (n - 1 - minPos);
    } else {
        ans = maxPos + (n - 1 - minPos) - 1;
    }

    cout << ans;
}
