#include <bits/stdc++.h>
using namespace std;

int main() {
	string s;
	cin>>s;
	if (s.length()<7){
	    cout<<"NO";
	    return 0;
	}
	int n=1;
	
	
	for (int i=0;i<s.length()-1;++i){
	    if (s[i]==s[i+1]){
	        
	        n++;
	        
	        if (n>=7){
	            cout<<"YES";
	            return 0;
	        }
	        
	    }else{
	        n=1;
	    }
	}if (n>=7){
	    cout<<"YES";
	    
	}else{
	    cout<<"NO";
	}

}
