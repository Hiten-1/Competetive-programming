#include <bits/stdc++.h>
using namespace std;

int main() {
	string s;
	cin>>s;
	vector<int> nums;
	for (int i=0;i<s.size();++i){
	    if (s[i]!='+'){
	        
	        nums.push_back(s[i]-'0');
	        
	    }
	    
	    
	}sort(nums.begin(),nums.end());
	int n=nums.size();
	for (int i=0;i<n-1;++i){
	    cout<<nums[i]<< "+";
	}cout<<nums[n-1];
	

}
